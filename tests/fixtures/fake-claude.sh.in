printf '%s\0' "$@" > "{bin_dir}/claude.argv"
cat > "{bin_dir}/claude.stdin"
{capture}
for required in "-p" "--output-format json" "--permission-mode plan" "--json-schema"; do
  case " $* " in
    *" $required "*) ;;
    *) echo "missing $required" >&2; exit 64;;
  esac
done
cat <<'JSON'
{stdout}
JSON
exit {exit_code}
