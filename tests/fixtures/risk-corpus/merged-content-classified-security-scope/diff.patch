+    calls = {"count": 0}
+    real = projection._authenticate_coordinator_record_ids_uncached
+
+    def counting(records):
+        calls["count"] += 1
+        return real(records)
+
+    monkeypatch.setattr(
+        projection, "_authenticate_coordinator_record_ids_uncached", counting
+    )
+    history: list[dict[str, object]] = [{"task_id": "t1"}, {"task_id": "t2"}]
+    first = projection._authenticated_coordinator_record_ids(history)
