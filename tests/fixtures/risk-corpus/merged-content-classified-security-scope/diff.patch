+def test_authentication_cache_eviction_preserves_other_entries(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    projection = sys.modules["dispatch_authority_projection"]
+    projection._authentication_cache.clear()
+    calls = {"count": 0}
+    real = projection._authenticate_coordinator_record_ids_uncached
+
+    def counting(records):
+        calls["count"] += 1
+        return real(records)
+
+    monkeypatch.setattr(
+        projection, "_authenticate_coordinator_record_ids_uncached", counting
+    )
+    limit = projection._AUTHENTICATION_CACHE_LIMIT
+    histories = [[{"task_id": f"t{n}"}] for n in range(limit + 1)]
+    results = [
+        projection._authenticated_coordinator_record_ids(history)
+        for history in histories
+    ]
+    assert calls["count"] == limit + 1
+    assert len(projection._authentication_cache) == limit
+    # Overflow evicted only the oldest entry: the newest `limit` histories
+    # are still served from cache with their own correct results.
+    for history, result in zip(histories[1:], results[1:], strict=True):
+        assert projection._authenticated_coordinator_record_ids(history) is result
+    assert calls["count"] == limit + 1
+    # The evicted oldest history recomputes rather than serving a stale entry.
+    projection._authenticated_coordinator_record_ids(histories[0])
+    assert calls["count"] == limit + 2
+    projection._authentication_cache.clear()
