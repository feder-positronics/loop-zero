+def test_transient_key_derivation_failure_propagates_and_is_not_cached(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    projection = sys.modules["dispatch_authority_projection"]
+    # Bind to the exact module namespace the projection's verify function
