+def test_operational_verification_failure_is_not_cached(
+    monkeypatch: pytest.MonkeyPatch,
+) -> None:
+    projection = sys.modules["dispatch_authority_projection"]
+    authority = sys.modules["dispatch_authority"]
+    projection._authentication_cache.clear()
+    record: dict[str, object] = {
+        "task_id": "t1",
+        "terminal_authority_proof": {"authority_kind": "coordinator", "scheme": "x"},
+    }
+    calls = {"count": 0}
+
+    def transient(*args, **kwargs):
+        calls["count"] += 1
+        raise projection.TerminalAuthorityOperationalError("Ed25519 timed out")
+
+    monkeypatch.setattr(projection, "verify_terminal_authority", transient)
+    history = [record]
+    first = projection._authenticated_coordinator_record_ids(history)
+    second = projection._authenticated_coordinator_record_ids(history)
+    assert first == frozenset() and second == frozenset()
+    # The transient rejection is recomputed, never served from cache.
+    assert calls["count"] == 2
+    assert len(projection._authentication_cache) == 0
+
+    def durable(*args, **kwargs):
+        calls["count"] += 1
+        raise projection.TerminalAuthorityError("invalid proof")
+
+    monkeypatch.setattr(projection, "verify_terminal_authority", durable)
+    third = projection._authenticated_coordinator_record_ids(history)
+    fourth = projection._authenticated_coordinator_record_ids(history)
+    assert third is fourth
+    # The durable invalid-proof rejection is cached after one computation.
+    assert calls["count"] == 3
+    projection._authentication_cache.clear()
