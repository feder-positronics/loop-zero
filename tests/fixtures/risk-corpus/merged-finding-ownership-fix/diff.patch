+def test_run_owned_finding_leases_reject_cross_lease_duplicate_findings() -> None:
+    module = load_module()
+    run_id = "sr_" + "a" * 32
+    owner = {
+        "coordinator_id": "coordinator",
+        "run_id": run_id,
+        "worker_session_id": "worker",
+    }
+    records = [
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_one",
+            "finding_ids": ["f_shared", "f_only_one"],
+            "owner": owner,
+        },
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_two",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+    ]
+
+    with pytest.raises(module.PipelineError, match="owned by unsettled leases"):
+        module.run_owned_finding_leases(records, run_id=run_id)
+
+
+def test_run_owned_finding_leases_allow_release_then_reacquire() -> None:
+    module = load_module()
+    run_id = "sr_" + "a" * 32
+    owner = {
+        "coordinator_id": "coordinator",
+        "run_id": run_id,
+        "worker_session_id": "worker",
+    }
+    records = [
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_one",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+        {
+            "type": "finding-lease-released",
+            "lease_id": "fl_one",
+            "owner": owner,
+        },
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_two",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+    ]
+
+    leases = module.run_owned_finding_leases(records, run_id=run_id)
+
+    assert [record["lease_id"] for record in leases] == ["fl_one", "fl_two"]
+
+
+def test_run_owned_finding_leases_allow_ownerless_recovery_then_reacquire() -> None:
+    module = load_module()
+    run_id = "sr_" + "a" * 32
+    owner = {
+        "coordinator_id": "coordinator",
+        "run_id": run_id,
+        "worker_session_id": "worker",
+    }
+    records = [
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_one",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+        # Audited recovery and terminal handoff may be recorded without the
+        # owning run's identity; both must still free the lease.
+        {
+            "type": "finding-lease-recovered",
+            "settled_lease_ids": ["fl_one"],
+        },
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_two",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+        {
+            "type": "finding-lease-owner-terminal",
+            "lease_id": "fl_two",
+        },
+        {
+            "type": "finding-lease-acquired",
+            "lease_id": "fl_three",
+            "finding_ids": ["f_shared"],
+            "owner": owner,
+        },
+    ]
+
+    leases = module.run_owned_finding_leases(records, run_id=run_id)
+
+    assert [record["lease_id"] for record in leases] == [
+        "fl_one",
+        "fl_three",
+        "fl_two",
+    ]
