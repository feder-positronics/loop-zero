STATE = Path(os.environ.get("AI_ACCOUNTS_HOME", Path.home() / ".local/state/ai-accounts"))
MARGIN = float(os.environ.get("AI_ACCOUNTS_MARGIN", "0.95"))
CLAUDE_NON_OWNER_LIMIT = 85
MAX_BACKOFF = 24 * 60 * 60
CODEX_MAIN = Path.home() / ".codex"
CLAUDE_TIERS = ((2, "fable+opus", ("claude-fable-5-2", "claude-opus-5-5")),
                (1, "opus", ("claude-opus-5-5",)))
CODEX_TIER_NAMES = {2: "all-models", 1: "restricted", 0: "none", -1: "unknown"}
CLAUDE_TIER_NAMES = {2: "fable+opus", 1: "opus", 0: "none", -1: "unknown"}
# Per-account files; everything else in ~/.codex is shared so threads resume across accounts.
CODEX_PRIVATE = ("auth.json",)
USAGE_LIMIT_RE = re.compile(
    r"usage limit reached|reached your [\w .-]*limit|hit your (?:usage )?limit|usage_limit_reached|weekly limit",
    re.IGNORECASE)
PROVIDERS = ("claude", "codex")
SHIMS = {"claude": "claude", "codex": "codex", "loopzero": "claude,codex"}
EXPLICIT_ROUTES = {
    "claude": ("ANTHROPIC_API_KEY", "ANTHROPIC_AUTH_TOKEN", "ANTHROPIC_BASE_URL",
               "CLAUDE_CODE_USE_BEDROCK", "CLAUDE_CODE_USE_VERTEX", "CLAUDE_CODE_USE_FOUNDRY"),
    "codex": ("OPENAI_API_KEY", "OPENAI_BASE_URL"),
}


def now() -> float:
    return time.time()


def iso(ts: float | str | None) -> str:
    ts = reset_timestamp(ts)
    if ts is None:
        return "-"
    return dt.datetime.fromtimestamp(ts, ZoneInfo("Europe/Warsaw")).strftime("%a %d %b %H:%M %Z")


def log(msg: str) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    with open(STATE / "log", "a", encoding="utf-8") as fh:
        fh.write(f"{dt.datetime.now(ZoneInfo('Europe/Warsaw')).strftime('%Y-%m-%d %H:%M:%S %Z')} {msg}\n")


def notify(msg: str) -> None:
    log(msg)
    if shutil.which("notify-send"):
        subprocess.run(["notify-send", "-a", "ai-accounts", "AI account switched", msg],
                       check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def write_private(path: Path, text: str) -> None:
    path.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
    tmp = path.with_name(f"{path.name}.{os.getpid()}.{threading.get_ident()}.tmp")
    fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
    with os.fdopen(fd, "w", encoding="utf-8") as fh:
        fh.write(text)
    os.replace(tmp, path)


# ----------------------------------------------------------------- accounts


def claude_accounts() -> list[str]:
    d = STATE / "claude/tokens"
    return sorted(p.name for p in d.iterdir() if p.is_file()) if d.is_dir() else []


def codex_accounts() -> list[str]:
    d = STATE / "codex/homes"
    extra = sorted(p.name for p in d.iterdir() if p.is_dir()) if d.is_dir() else []
    return (["main"] if (CODEX_MAIN / "auth.json").is_file() else []) + extra


def accounts(provider: str) -> list[str]:
    return claude_accounts() if provider == "claude" else codex_accounts()


def codex_home(name: str) -> Path:
    return CODEX_MAIN if name == "main" else STATE / "codex/homes" / name


def claude_token(name: str) -> str:
    return (STATE / "claude/tokens" / name).read_text(encoding="utf-8").strip()


def active(provider: str) -> str | None:
    names = accounts(provider)
    f = STATE / provider / "active"
    cur = f.read_text(encoding="utf-8").strip() if f.is_file() else ""
    if cur in names:
        return cur
    return names[0] if names else None


def set_active(provider: str, name: str) -> None:
    write_private(STATE / provider / "active", name + "\n")


def shared(entry: Path) -> bool:
    return entry.name not in CODEX_PRIVATE and not entry.name.endswith(".lock")


def sync_codex_home(home: Path) -> None:
    """Keep an extra CODEX_HOME a mirror of ~/.codex except its own auth.json.

    Entries the account created itself move into ~/.codex (unless ~/.codex already has one),
    then every shared ~/.codex entry is linked, including ones created after `add`.
    """
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    # Own lock (check() holds .lock while calling this); Codex may still create entries
    # concurrently, so a lost race on one entry is skipped, not fatal.
    with open(STATE / ".codex-sync.lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        for entry in home.iterdir():
            target = CODEX_MAIN / entry.name
            if shared(entry) and not entry.is_symlink() and not target.exists() \
                    and not target.is_symlink():
                try:
                    os.rename(entry, target)
                except FileNotFoundError:
                    pass
        for src in CODEX_MAIN.iterdir():
            dst = home / src.name
            if shared(src) and not dst.exists() and not dst.is_symlink():
                try:
                    dst.symlink_to(src)
                except FileExistsError:
                    pass


def identity(provider: str, name: str) -> str:
    """Opaque binding; Codex refreshes tokens in place without changing its account."""
    credential = (claude_token(name).encode() if provider == "claude" else
                  (codex_home(name) / "auth.json").read_bytes())
    if provider == "codex":
        try:
            auth = json.loads(credential)
        except ValueError:
            auth = {}
        tokens = auth.get("tokens") if isinstance(auth, dict) else None
        tokens = tokens if isinstance(tokens, dict) else {}
        claims = jwt_claims(tokens.get("id_token", ""))
        principal = {key: value if isinstance(value, str) else None for key, value in
                     {"account": tokens.get("account_id"), "subject": claims.get("sub"),
                      "issuer": claims.get("iss")}.items()}
        if principal["subject"]:
            credential = json.dumps({"home": str(codex_home(name).resolve()), **principal},
                                    sort_keys=True).encode()
        # Unidentified legacy files retain strict revision matching: without an
        # account principal, token replacement cannot safely be called a refresh.
    return hashlib.sha256(provider.encode() + b"\0" + name.encode() + b"\0" + credential).hexdigest()


def marker(provider: str) -> str:
    return f"AI_ACCOUNTS_{provider.upper()}_IDENTITY"


def managed_name(provider: str, env: dict[str, str]) -> str | None:
    if provider not in PROVIDERS or any(env.get(key) for key in EXPLICIT_ROUTES[provider]):
        return None
    value = env.get("CLAUDE_CODE_OAUTH_TOKEN" if provider == "claude" else "CODEX_HOME")
    for name in accounts(provider):
        try:
            expected = claude_token(name) if provider == "claude" else str(codex_home(name))
            if value == expected and env.get(marker(provider)) == identity(provider, name):
                return name
        except (OSError, ValueError):
            continue
    return None


def account_env(provider: str, name: str | None = None) -> dict[str, str]:
    name = active(provider) if name is None else name
    if name is None:
        return {}
    if provider == "claude":
        env = {"CLAUDE_CODE_OAUTH_TOKEN": claude_token(name)}
    else:
        if name != "main":
            sync_codex_home(codex_home(name))
        env = {"CODEX_HOME": str(codex_home(name)),
               "AI_ACCOUNTS_CODEX_HOME": str(codex_home(name))}
    return {**env, marker(provider): identity(provider, name)}


def with_accounts(providers: str, base: dict[str, str],
                  selected: dict[str, str | None] | None = None) -> dict[str, str]:
    """Rebind verified managed inheritance; caller credentials and billing always win."""
    env = dict(base)
    for provider in providers.split(","):
        if provider not in PROVIDERS:
            continue
        credential = "CLAUDE_CODE_OAUTH_TOKEN" if provider == "claude" else "CODEX_HOME"
        if any(env.get(key) for key in EXPLICIT_ROUTES[provider]):
            continue
        if not env.get(credential) or managed_name(provider, env) is not None:
            if selected is None or provider not in selected:
                env.update(account_env(provider))
            elif selected[provider] is not None:
                env.update(account_env(provider, selected[provider]))
    return env


# ----------------------------------------------------------------- probes


def _http(req: urllib.request.Request, timeout: int = 30) -> tuple[int, dict[str, str], bytes]:
    try:
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            return resp.status, {k.lower(): v for k, v in resp.headers.items()}, resp.read()
    except urllib.error.HTTPError as exc:
        return exc.code, {k.lower(): v for k, v in exc.headers.items()}, exc.read()


def reset_timestamp(value) -> float | None:
    try:
        return float(value) if not isinstance(value, bool) else None
    except (TypeError, ValueError):
        try:
            return dt.datetime.fromisoformat(value.replace("Z", "+00:00")).timestamp()
        except (AttributeError, ValueError):
            return None


def binding_reset(windows: list[dict]) -> float | None:
    """All binding windows must clear before the account is below the margin."""
    binding = [reset_timestamp(w.get("resets_at")) for w in windows if
               w.get("status") == "rejected" or (w.get("used_pct") or 0) >= MARGIN * 100]
    if not binding or None in binding:
        return None
    return max(binding)


def claude_windows(result: dict, fetched_at: float) -> list[dict]:
    """Normalize legacy model headers without conflating their reset times."""
    found = {}
    for model in result.get("models", {}).values():
        if not isinstance(model, dict):
            continue
        keys = set(model.get("util", {})) | set(model.get("resets", {}))
        keys |= set(model.get("window_status", {}))
        for key in keys - {"", "overage"}:
            percent = model.get("util", {}).get(key)
            window = {"window": key, "used_pct": percent * 100 if percent is not None else None,
                      "resets_at": model.get("resets", {}).get(key),
                      "status": model.get("window_status", {}).get(key),
                      "source": "headers (fallback)", "fetched_at": fetched_at}
            old = found.get(key)
            if old is not None:
                window["used_pct"] = max((v for v in (old["used_pct"], window["used_pct"]) if v is not None), default=None)
                window["resets_at"] = window["resets_at"] or old["resets_at"]
                window["status"] = "rejected" if "rejected" in (old["status"], window["status"]) else window["status"] or old["status"]
            found[key] = window
    return list(found.values())


def claude_api_windows(data: dict, fetched_at: float) -> list[dict]:
    limits = data.get("limits")
    if not isinstance(limits, list):
        raise ValueError("usage API has no limits array")
    windows = []
    names = {"session": "5h", "weekly_all": "7d"}
    for limit in limits:
        if not isinstance(limit, dict):
            continue
        kind = limit.get("kind") or limit.get("type")
        scope = limit.get("scope") or {}
        model = limit.get("model") or (scope.get("model") or scope.get("id") if isinstance(scope, dict) else scope)
        if isinstance(model, dict):
            model = model.get("display_name") or model.get("id")
        key = names.get(kind)
        if kind == "weekly_scoped" and isinstance(model, str):
            key = "7d_oi" if "fable" in model.lower() else "7d_" + model
        if key is None:
            raise ValueError("usage API has an unrecognized window or scope")
        percent = limit.get("used_percent", limit.get("percent", limit.get("utilization")))
        if not isinstance(percent, (int, float)) or isinstance(percent, bool) or not 0 <= percent <= 100:
            raise ValueError("usage API has invalid window utilization")
        window = {"window": key, "used_pct": percent,
                  "resets_at": reset_timestamp(limit.get("resets_at")),
                  "source": "OAuth usage API", "fetched_at": fetched_at}
        if isinstance(limit.get("cap_percent"), (int, float)):
            window["cap_percent"] = limit["cap_percent"]
        windows.append(window)
    if not windows or not any(w["window"] == "7d" for w in windows):
        raise ValueError("usage API has no overall weekly window")
    return windows


def probe_claude_model(token: str, model: str) -> dict:
    """One max_tokens=1 request; the unified rate-limit headers describe the account."""
    body = json.dumps({
        "model": model, "max_tokens": 1,
        "system": "You are Claude Code, Anthropic's official CLI for Claude.",
        "messages": [{"role": "user", "content": "hi"}],
    }).encode()
    req = urllib.request.Request("https://api.anthropic.com/v1/messages", data=body, headers={
        "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20",
        "anthropic-version": "2023-06-01", "content-type": "application/json",
    })
    code, headers, _ = _http(req)
    prefix = "anthropic-ratelimit-unified-"
    # Bare unified-status/reset describe the representative claim, not an empty window.
    claims = {"five_hour": "5h", "session": "5h", "seven_day": "7d",
              "seven_day_oi": "7d_oi", "seven_day_fable": "7d_oi"}
    claim = claims.get(headers.get(prefix + "representative-claim"))
    fields = {}
    for key, value in headers.items():
        if key.startswith(prefix):
            tail = key[len(prefix):]
            if tail in ("status", "reset") and claim:
                fields.setdefault(claim, {}).setdefault(tail, value)
            elif "-" in tail:
                window, field = tail.rsplit("-", 1)
                if window != "overage" and field in ("utilization", "reset", "status"):
                    fields.setdefault(window, {})[field] = value
    util = {k: float(v["utilization"]) for k, v in fields.items() if "utilization" in v}
    statuses = {k: v["status"] for k, v in fields.items() if "status" in v}
    rejected = [k for k, v in statuses.items() if v == "rejected"]
    ok = code == 200 and not rejected and all(u < MARGIN for u in util.values())
    # The binding claims are the rejected or over-margin ones; usable again after the last resets.
    binding = set(rejected) | {k for k, u in util.items() if u >= MARGIN}
    window_resets = {k: reset_timestamp(v.get("reset")) for k, v in fields.items()}
    # Legacy aggregate stays unknown if any binding window's reset is missing.
    reset = binding_reset([{"used_pct": util[k] * 100 if k in util else None,
                            "status": statuses.get(k), "resets_at": window_resets[k]}
                           for k in binding])
    return {"http": code, "ok": ok, "util": util, "rejected": rejected, "window_status": statuses,
            "org": headers.get("anthropic-organization-id"),
            "resets": window_resets, "reset": reset if not ok else None}


def check_claude(name: str) -> dict:
    next_file = STATE / "claude/usage-next" / name
    try:
        next_allowed = float(next_file.read_text())
        if not math.isfinite(next_allowed) or next_allowed > now() + MAX_BACKOFF:
            next_allowed = 0
    except (OSError, ValueError):
        next_allowed = 0
    try:
        if now() < next_allowed:
            raise ValueError(f"usage API backoff until {dt.datetime.fromtimestamp(next_allowed, dt.timezone.utc).isoformat()}")
        token = claude_token(name)
        req = urllib.request.Request("https://api.anthropic.com/api/oauth/usage", headers={
            "Authorization": f"Bearer {token}", "anthropic-beta": "oauth-2025-04-20"})
        try:
            code, headers, raw = _http(req)
        finally:
            next_allowed = now() + 1800
            write_private(next_file, str(next_allowed) + "\n")
        if code == 429:
            retry_after = headers.get("retry-after", "")
            try:
                retry_at = now() + int(retry_after)
            except OverflowError:
                retry_at = now() + MAX_BACKOFF
            except ValueError:
                try:
                    retry_date = parsedate_to_datetime(retry_after)
                    if retry_date.tzinfo is None:
                        retry_date = retry_date.replace(tzinfo=dt.timezone.utc)
                    retry_at = retry_date.timestamp()
                except (TypeError, ValueError, OverflowError):
                    retry_at = 0
            next_allowed = max(next_allowed, min(retry_at, now() + MAX_BACKOFF))
            write_private(next_file, str(next_allowed) + "\n")
        if code != 200:
            log(f"claude {name}: usage API HTTP {code}; backoff until {dt.datetime.fromtimestamp(next_allowed, dt.timezone.utc).isoformat()}")
            raise ValueError(f"usage API HTTP {code}")
        data = json.loads(raw)
        if not isinstance(data, dict):
            raise ValueError("usage API response is not an object")
        windows = claude_api_windows(data, now())
        overall = [w for w in windows if w["window"] != "7d_oi"]
        tier = 0 if any(w["used_pct"] >= MARGIN * 100 for w in overall) else (
            1 if any(w["used_pct"] >= MARGIN * 100 for w in windows) else 2)
        return {"tier": tier, "util": max(w["used_pct"] for w in windows) / 100,
                "windows": windows, "next_reset": binding_reset(windows),
                "source": "OAuth usage API", "fetched_at": now(),
                "plan": data.get("plan_type") or data.get("plan")}
    except (urllib.error.URLError, TimeoutError, OSError, ValueError) as exc:
        api_error = str(exc) if isinstance(exc, ValueError) else type(exc).__name__
    try:
        result = check_claude_headers(name)
    except (ValueError, OSError) as exc:
        result = {"tier": -1, "error": f"header fallback failed ({type(exc).__name__})"}
    result.update(source="headers (fallback)", fetched_at=now(), source_reason=api_error)
    result["windows"] = claude_windows(result, result["fetched_at"])
    result["next_reset"] = binding_reset(result["windows"])
    return result


def check_claude_headers(name: str) -> dict:
    token = claude_token(name)
    models: dict[str, dict] = {}
    email = claude_email(name, None)
    try:
        for _, _, needed in CLAUDE_TIERS:
            for model in needed:
                if model not in models:
                    models[model] = probe_claude_model(token, model)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {"tier": -1, "email": email, "error": f"network: {exc}"}
    if any(m["http"] in (401, 403) for m in models.values()):
        return {"tier": -1, "email": email, "models": models,
                "error": "token rejected (401/403): run `claude setup-token` again"}
    failed = [m["http"] for m in models.values() if m["http"] != 200 and
              not (m["http"] == 429 and (m.get("util") or m.get("rejected")))]
    if failed:
        return {"tier": -1, "email": email, "models": models,
                "error": f"header probe HTTP {failed[0]} without usable quota evidence"}
    tier = next((t for t, _, needed in CLAUDE_TIERS if all(models[m]["ok"] for m in needed)), 0)
    usable = next((needed for t, _, needed in CLAUDE_TIERS if t == tier), tuple(models))
    util = max((u for m in usable for u in models[m]["util"].values()), default=0.0)
    # Legacy aggregate next_reset: when the best tier can come back.
    resets = [models[m]["reset"] for m in CLAUDE_TIERS[0][2] if models[m]["reset"]]
    org = next((m["org"] for m in models.values() if m.get("org")), None)
    return {"tier": tier, "util": util, "models": models, "email": claude_email(name, org),
            "next_reset": min(resets) if resets else None}


def claude_email(name: str, org: str | None) -> str | None:
    """A stored label, else the interactive login's email when the organization matches."""
    label = STATE / "claude/emails" / name
    if label.is_file():
        return label.read_text(encoding="utf-8").strip()
    for config in (Path(os.environ.get("CLAUDE_CONFIG_DIR", Path.home() / ".claude")) / ".claude.json",
                   Path.home() / ".claude.json"):
        try:
            acct = json.loads(config.read_text(encoding="utf-8")).get("oauthAccount") or {}
        except (OSError, ValueError):
            continue
        if org and acct.get("organizationUuid") == org:
            return acct.get("emailAddress")
    return None


def jwt_claims(token: str) -> dict:
    try:
        payload = token.split(".")[1]
        claims = json.loads(base64.urlsafe_b64decode(payload + "=" * (-len(payload) % 4)))
        return claims if isinstance(claims, dict) else {}
    except (AttributeError, IndexError, ValueError, TypeError):
        return {}


def refresh_codex(auth_file: Path, auth: dict) -> tuple[str, dict]:
    """Refresh a ChatGPT login as Codex does, so idle standby accounts stay usable."""
    tokens = auth["tokens"]
    claims = jwt_claims(tokens["access_token"])
    body = json.dumps({"client_id": claims["client_id"], "grant_type": "refresh_token",
                       "refresh_token": tokens["refresh_token"], "scope": "openid profile email"})
    issuer = jwt_claims(tokens["id_token"]).get("iss", "https://auth.openai.com")
    req = urllib.request.Request(f"{issuer}/oauth/token", data=body.encode(),
                                 headers={"Content-Type": "application/json"})
    code, _, raw = _http(req)
    if code != 200:
        raise ValueError(f"HTTP {code}; run `CODEX_HOME={auth_file.parent} codex login`")
    fresh = json.loads(raw)
    tokens.update({k: fresh[k] for k in ("id_token", "access_token", "refresh_token") if fresh.get(k)})
    auth["last_refresh"] = dt.datetime.now(dt.timezone.utc).isoformat().replace("+00:00", "Z")
    # Rewrite in place like Codex: reviewers bind-mount this inode, so os.replace would detach them.
    with open(auth_file, "r+", encoding="utf-8") as fh:
        fh.write(json.dumps(auth, indent=2) + "\n")
        fh.truncate()
    log(f"codex: refreshed {auth_file}")
    return tokens["access_token"], tokens


def codex_in_use(home: Path) -> bool:
    """Whether a live codex process may use this CODEX_HOME (default ~/.codex).

    A process whose account cannot be attributed (unreadable environment, or a private HOME
    without CODEX_HOME, as in loop-zero's reviewer sandbox that binds only auth.json) counts
    as using every account, which only defers a refresh to a later check.
    """
    target = home.resolve()
    for proc in Path("/proc").iterdir():
        if not proc.name.isdigit():
            continue
        try:
            if proc.stat().st_uid != os.getuid():
                continue
            argv = (proc / "cmdline").read_bytes().split(b"\0")
            if not any(Path(a.decode(errors="replace")).name == "codex" for a in argv[:2]):
                continue
        except OSError:
            continue
        try:
            env = dict(v.split(b"=", 1) for v in (proc / "environ").read_bytes().split(b"\0") if b"=" in v)
        except OSError:
            return True
        if b"CODEX_HOME" not in env and env.get(b"HOME", b"").decode() != str(Path.home()):
            return True
        used = Path(env[b"CODEX_HOME"].decode()) if b"CODEX_HOME" in env else CODEX_MAIN
        if used.resolve() == target:
            return True
    return False


def check_codex(name: str) -> dict:
    auth_file = codex_home(name) / "auth.json"
    try:
        auth = json.loads(auth_file.read_text(encoding="utf-8"))
    except (OSError, ValueError):
        return {"tier": -1, "error": f"no readable {auth_file}: run `CODEX_HOME={auth_file.parent} codex login`"}
    tokens = auth.get("tokens") or {}
    email = jwt_claims(tokens.get("id_token", "")).get("email")
    access = tokens.get("access_token")
    if not access:
        return {"tier": -1, "email": email,
                "error": "not a ChatGPT login (API key accounts have no plan limits)"}
    # Only idle standby logins: running sessions keep their login fresh, and rotating the
    # refresh token under a session would revoke that session's cached copy.
    idle = name != active("codex") and not codex_in_use(codex_home(name))
    if idle and jwt_claims(access).get("exp", 0) < now() + 86400:
        try:
            access, tokens = refresh_codex(auth_file, auth)
        except (urllib.error.URLError, TimeoutError, OSError, ValueError, KeyError) as exc:
            return {"tier": -1, "email": email, "error": f"token refresh failed: {exc}"}
    req = urllib.request.Request("https://chatgpt.com/backend-api/wham/usage", headers={
        "Authorization": f"Bearer {access}", "ChatGPT-Account-Id": tokens.get("account_id", ""),
        "User-Agent": "codex_cli_rs",
    })
    try:
        code, _, body = _http(req)
    except (urllib.error.URLError, TimeoutError, OSError) as exc:
        return {"tier": -1, "email": email, "error": f"network: {exc}"}
    if code != 200:
        return {"tier": -1, "email": email, "error": f"usage endpoint HTTP {code}"}
    try:
        data = json.loads(body)
    except (TypeError, ValueError) as exc:
        return {"tier": -1, "email": email, "error": f"invalid usage response: {exc}"}
    if not isinstance(data, dict):
        return {"tier": -1, "email": email, "error": "usage response is not an object"}
    rl = data.get("rate_limit")
    if not isinstance(rl, dict):
        return {"tier": -1, "email": email, "error": "usage response has no rate-limit windows"}
    windows = [w for w in (rl.get("primary_window"), rl.get("secondary_window")) if w]
    if not windows or any(not isinstance(w, dict) or
                          not isinstance(w.get("used_percent"), (int, float)) or
                          isinstance(w.get("used_percent"), bool) for w in windows):
        return {"tier": -1, "email": email, "error": "usage response has no usable rate-limit windows"}
    util = max((w.get("used_percent", 0) / 100 for w in windows), default=0.0)
    ok = bool(rl.get("allowed", True)) and not rl.get("limit_reached") and util < MARGIN
    fetched_at = now()
    normalized = []
    for slot in ("primary_window", "secondary_window"):
        window = rl.get(slot)
        if not window:
            continue
        seconds = window.get("limit_window_seconds")
        key = {18000: "5h", 604800: "7d"}.get(seconds, slot)
        reset = reset_timestamp(window.get("reset_at"))
        if reset is None and isinstance(window.get("reset_after_seconds"), (int, float)):
            reset = fetched_at + window["reset_after_seconds"]
        normalized.append({"window": key, "used_pct": window["used_percent"],
                           "limit_window_seconds": seconds, "resets_at": reset,
                           "source": "wham/usage API", "fetched_at": fetched_at})
    result = {"tier": -1, "util": util, "plan": data.get("plan_type"),
              "email": data.get("email") or email, "windows": normalized,
              "source": "wham/usage API", "fetched_at": fetched_at,
              "next_reset": binding_reset(normalized)}
    model_usage = data.get("model_usage")
    if not isinstance(model_usage, dict) or not model_usage:
        return {**result, "error": "usage response has no model usage"}
    if any(not isinstance(v, dict) or not isinstance(v.get("available"), bool)
           for v in model_usage.values()):
        return {**result, "error": "usage response has incomplete model usage"}
    models = {m: v["available"] for m, v in model_usage.items()}
    usable = [available for available in models.values() if available]
    tier = 0 if not ok or (models and not usable) else (2 if all(models.values()) else 1)
    return {**result, "tier": tier, "models": models}


def select(provider: str, results: dict[str, dict], current: str | None) -> str | None:
    known = {n: r for n, r in results.items() if r["tier"] >= 0}
    if not known:
        return current
    best = max(r["tier"] for r in known.values())
    if current in known and known[current]["tier"] == best:
        if provider == "codex" and known[current].get("util", 1.0) >= CLAUDE_NON_OWNER_LIMIT / 100:
            below_reserve = [n for n, r in known.items()
                             if r["tier"] == best and r.get("util", 1.0) < CLAUDE_NON_OWNER_LIMIT / 100]
            if below_reserve:
                return min(below_reserve, key=lambda n: known[n]["util"])
        return current
    if best == 0 and current in results:
        return current  # nothing usable anywhere; do not churn
    return min((n for n, r in known.items() if r["tier"] == best),
               key=lambda n: known[n].get("util", 1.0))


def claude_weekly_used_percent(result: dict) -> float | None:
    """Overall weekly window; short and model-specific windows are separate limits."""
    if "windows" in result:
        return next((w.get("used_pct", w.get("used_percent")) for w in result["windows"] if w["window"] == "7d"), None)
    values = [m["util"]["7d"] for m in result.get("models", {}).values()
              if "7d" in m.get("util", {})]
    return max(values) * 100 if values else None


def claude_exec_refusal(name: str | None) -> str | None:
    if name is None or os.environ.get("AI_ACCOUNTS_CLAUDE_OWNER") == "1":
        return None
    reason = None
    try:
        status = json.loads((STATE / "status.json").read_text())
        result = status["providers"]["claude"]["accounts"][name]
        if not isinstance(result, dict) or now() - status["checked_at"] > 1200:
            reason = "cached status missing or older than 20 minutes"
        else:
            windows = result.get("windows")
            if windows is None:
                windows = claude_windows(result, status["checked_at"])
            for window in windows:
                percent = window.get("used_pct", window.get("used_percent"))
                if percent is not None and percent >= CLAUDE_NON_OWNER_LIMIT:
                    reset = window.get("resets_at")
                    return (f"{window['window']} window {percent:g}% used (limit 85%); " +
                            (f"resets {iso(reset)}" if reset is not None else "reset unknown"))
    except (OSError, ValueError, TypeError, AttributeError, KeyError):
        reason = "cached status missing or unreadable"
    return reason


def claude_exec_allowed(name: str | None) -> bool:
    reason = claude_exec_refusal(name)
    if reason is not None:
        print(f"ai-accounts: refusing Claude launch for account {name}: {reason}.", file=sys.stderr)
    return reason is None


def snapshot_fields(result: dict, instance: str, checked_at: float) -> None:
    """One status-file schema for the CLI, guard and status page; no extra state."""
    if "windows" not in result:
        result["windows"] = claude_windows(result, checked_at)
    windows = result["windows"]
    result["instance"] = instance
    result["unknown_reason"] = None if windows else result.get("error", "no rate-limit snapshot cached")
    for window in windows:
        reset = reset_timestamp(window.get("resets_at"))
        window.update(instance=instance, used_pct=window.pop("used_percent", window.get("used_pct")),
                      resets_at=dt.datetime.fromtimestamp(reset, dt.timezone.utc).isoformat().replace("+00:00", "Z") if reset is not None else None,
                      resets_local=iso(reset) if reset is not None else None,
                      snapshot_age_s=max(0, int(now() - window.get("fetched_at", checked_at))),
                      unknown_reason=None)


def check(quiet: bool = False) -> dict:
    STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
    with open(STATE / ".lock", "w") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            previous = json.loads((STATE / "status.json").read_text())
        except (OSError, ValueError):
            previous = {}
        status = {"checked_at": now(), "providers": {},
                  "exhausted": previous.get("exhausted", {}),
                  "selections": previous.get("selections", {})}
        for provider in PROVIDERS:
            names = accounts(provider)
            if provider == "codex":
                for n in names[1:] if names[:1] == ["main"] else names:
                    sync_codex_home(codex_home(n))
            probe = check_claude if provider == "claude" else check_codex
            results = {n: probe(n) for n in names}
            if provider == "claude":
                for result in results.values():
                    result["weekly_used_percent"] = claude_weekly_used_percent(result)
            for name, result in results.items():
                old = previous.get("providers", {}).get(provider, {}).get("accounts", {}).get(name, {})
                snapshot_fields(result, name, status["checked_at"])
                snapshot_fields(old, name, previous.get("checked_at", 0))
                add_pace(result, old)
            current = active(provider)
            chosen = select(provider, results, current)
            if chosen and chosen != current:
                set_active(provider, chosen)
                tiers = CLAUDE_TIER_NAMES if provider == "claude" else CODEX_TIER_NAMES
                why = tiers[results[current]["tier"]] if current in results else "unset"
                notify(f"{provider}: {current} ({why}) -> {chosen} ({tiers[results[chosen]['tier']]})")
            elif chosen and not (STATE / provider / "active").is_file():
                set_active(provider, chosen)
            status["providers"][provider] = {"active": chosen, "accounts": results}
        write_private(STATE / "status.json", json.dumps(status, indent=1) + "\n")
    if not quiet:
        print_status(status)
    else:
        for provider, info in status["providers"].items():
            for name, result in info["accounts"].items():
                if result["tier"] == -1 and result.get("error"):
                    print(f"ai-accounts: {provider} {name}: {result['error']}", file=sys.stderr)
    return status


def add_pace(result: dict, previous: dict) -> None:
    old = {w["window"]: w for w in previous.get("windows", [])}
    for window in result.get("windows", []):
        before = old.get(window["window"], {})
        used, prior = window.get("used_pct"), before.get("used_pct")
        reset = reset_timestamp(window.get("resets_at"))
        elapsed = window["fetched_at"] - before.get("fetched_at", window["fetched_at"])
        if (used is not None and prior is not None and prior < used < 100 and elapsed > 0
                and reset is not None and reset == reset_timestamp(before.get("resets_at"))
                and window.get("source") == before.get("source")):
            runs_out = window["fetched_at"] + (100 - used) * elapsed / (used - prior)
            if runs_out < reset:
                window["runs_out_at"] = runs_out


def window_text(window: dict, label: str) -> str:
    percent = window.get("used_pct")
    used = f"{percent:g}% used" if percent is not None else "usage not reported"
    reset = window.get("resets_at")
    text = f"{label}: {used}, resets {window.get('resets_local') or iso(reset)}"
    if window.get("cap_percent") is not None:
        text += f" (cap = {window['cap_percent']:g}% of weekly)"
    if window.get("runs_out_at") and window["runs_out_at"] > now():
        text += f"; runs out ~{iso(window['runs_out_at'])}, before reset {iso(reset)}"
    return text


def print_status(status: dict) -> None:
    print(f"checked {iso(status.get('checked_at'))}  (margin {MARGIN:.0%})")
    if now() - status.get("checked_at", 0) > 600:
        print("STALE: no account check in over 10 minutes; check ai-accounts.timer")
    for provider, info in status.get("providers", {}).items():
        print(f"{provider}:")
        if not info["accounts"]:
            print("  (no accounts)")
        for name, result in info["accounts"].items():
            snapshot_fields(result, name, status.get("checked_at", 0))
            windows = {w["window"]: w for w in result["windows"]}
            labels = ({"7d_oi": "Fable week", "7d": "all models week", "5h": "WARNING temporary 5-hour limit"}
                      if provider == "claude" else {"5h": "5-hour", "7d": "week"})
            items = []
            for key in dict.fromkeys([*labels, *windows]):
                if key in windows:
                    text = window_text(windows[key], labels.get(key, key))
                    if provider == "claude" and key == "7d" and (windows[key].get("used_pct") or 0) >= MARGIN * 100:
                        text += " — blocks Fable too when full"
                    items.append(text)
                elif not windows:
                    items.append(f"usage: unknown ({result['unknown_reason']})")
                    break
                elif provider == "claude" and key == "7d_oi":
                    items.append("Fable week: not reported")
            source = result.get("source", "cached headers (fallback)" if windows else "cached status")
            age = max((w["snapshot_age_s"] for w in windows.values()), default=max(0, int(now() - status.get("checked_at", 0))))
            details = "; ".join(filter(None, [f"source: {source}, age {age}s", result.get("source_reason"), result.get("error")]))
            mark = "*" if name == info["active"] else " "
            plan = f" ({result['plan'].title()})" if isinstance(result.get("plan"), str) else ""
            email = result.get("email") or ("email unknown (ai-accounts label claude "
                                             f"{name} <email>)" if provider == "claude" else "email unknown")
            print(f" {mark}{name}{plan}  {email}  " + " | ".join(items) + f"  [{details}]")


