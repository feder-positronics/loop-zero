def cmd_add(provider: str, name: str) -> int:
    if not re.fullmatch(r"[A-Za-z0-9_][A-Za-z0-9_.-]*", name) or name == "main":
        sys.exit("ai-accounts: invalid account name")
    if provider == "claude":
        token = "".join(sys.stdin.read().split())
        if not token.startswith("sk-ant-"):
            sys.exit("ai-accounts: paste the token printed by `claude setup-token` on stdin")
        write_private(STATE / "claude/tokens" / name, token + "\n")
        print(f"stored claude account {name}; run `ai-accounts check`")
        return 0
    home = STATE / "codex/homes" / name
    home.mkdir(parents=True, exist_ok=True, mode=0o700)
    sync_codex_home(home)
    print(f"created {home} (shares ~/.codex except its own auth.json)")
    print(f"now log in with the other ChatGPT account:  CODEX_HOME={home} codex login")
    return 0


def cmd_exec(providers: str, argv: list[str]) -> int:
    if not argv:
        sys.exit("ai-accounts: missing command")
    base = dict(os.environ)
    # Caller-owned credentials and billing routes skip managed-account admission.
    if "claude" in providers.split(",") and not caller_credentials("claude", base):
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        with open(STATE / ".lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            name = active("claude")
            # The monitor switches only at the 95% margin; prefer any account under the reserve.
            if claude_exec_refusal(name) is not None:
                name = next((n for n in accounts("claude") if claude_exec_refusal(n) is None), name)
            if not claude_exec_allowed(name):
                return 3
            # Bind this approved selection; a later rotation cannot change env.
            env = with_accounts(providers, base, {"claude": name})
    else:
        env = with_accounts(providers, base)
    os.execvpe(argv[0], argv, env)
    return 127


def model_availability(provider: str, name: str, model: str) -> tuple[bool, bool, float]:
    if provider == "claude":
        evidence = probe_claude_model(claude_token(name), model)
        usable = evidence.get("ok") is True
        known = evidence.get("http") in (200, 400, 404) or (
            evidence.get("http") == 429 and bool(evidence.get("rejected") or any(
                value >= MARGIN for value in evidence.get("util", {}).values())))
        return usable, known, max(evidence.get("util", {}).values(), default=0)
    evidence = check_codex(name)
    availability = evidence.get("models", {}).get(model)
    known = evidence.get("tier", -1) >= 0 and isinstance(availability, bool)
    return (known and evidence["tier"] > 0 and availability is True,
            known, evidence.get("util", 1))


def caller_credentials(provider: str, env: dict[str, str]) -> bool:
    credential = "CLAUDE_CODE_OAUTH_TOKEN" if provider == "claude" else "CODEX_HOME"
    return any(env.get(key) for key in EXPLICIT_ROUTES[provider]) or bool(
        env.get(credential) and managed_name(provider, env) is None)


def launch(provider: str, model: str, env: dict[str, str]) -> dict:
    """Prepare a nonsecret exact-model identity; exec --identity pins the launch."""
    def result(outcome: str, name: str | None = None) -> dict:
        return {"outcome": outcome, "ready": outcome == "ready", "provider": provider,
                "model": model, "identity": identity(provider, name) if name else None}

    if provider not in PROVIDERS:
        return result("unsupported")
    if caller_credentials(provider, env) or not STATE.is_dir() or not accounts(provider):
        return result("unmanaged")
    with open(STATE / ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        try:
            status = json.loads((STATE / "status.json").read_text())
        except (OSError, ValueError):
            status = {}
        current = active(provider)
        names = sorted(accounts(provider), key=lambda name: name != current)
        unknown = False
        for name in names:
            try:
                revision = identity(provider, name)
                if status.get("exhausted", {}).get(revision + ":" + model, 0) > now():
                    continue
                # Preparing the selected account is not a rotation or an assertion
                # about model access. Let its native CLI validate a healthy launch;
                # partial quota telemetry must not prevent ordinary Codex startup.
                if name == current:
                    return result("ready", name)
                evidence = status.get("selections", {}).get(provider + ":" + model, {})
                if evidence.get("identity") == revision and evidence.get("until", 0) > now():
                    usable, known = True, True
                else:
                    usable, known, _ = model_availability(provider, name, model)
                if usable:
                    set_active(provider, name)
                    status.setdefault("selections", {})[provider + ":" + model] = {
                        "identity": revision, "until": now() + 300,
                    }
                    write_private(STATE / "status.json", json.dumps(status) + "\n")
                    return result("ready", name)
                unknown |= not known
            except (OSError, ValueError, KeyError, urllib.error.URLError):
                unknown = True
        return result("unknown" if unknown else "exhausted")


def cmd_pinned_exec(provider: str, revision: str, argv: list[str]) -> int:
    """Build the named revision under the selection lock, without rebinding active."""
    env = dict(os.environ)
    name = None
    if provider in PROVIDERS and STATE.is_dir() and not caller_credentials(provider, env):
        with open(STATE / ".lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            for candidate in accounts(provider):
                try:
                    if identity(provider, candidate) == revision:
                        env.update(account_env(provider, candidate))
                        if env.get(marker(provider)) == revision:
                            name = candidate
                        break
                except (OSError, ValueError):
                    continue
    if name is None or not argv:
        print(json.dumps({"outcome": "unsupported" if provider not in PROVIDERS else "unmanaged",
                          "provider": provider, "changed": False}))
        return 2
    if provider == "claude" and not claude_exec_allowed(name):
        return 3
    os.execvpe(argv[0], argv, env)
    return 127


def exhausted(provider: str, failed_identity: str, model: str) -> dict:
    """Compare-and-select for one exact provider/model, serialized with monitor checks.

    The caller sends only the opaque managed revision from its effective environment.
    Unknown availability cannot authorize selection. A short cooldown prevents an
    exhausted revision from winning again before a later quota reset/probe.
    """
    def result(outcome: str, name: str | None = None) -> dict:
        return {"outcome": outcome, "provider": provider, "model": model,
                "identity": identity(provider, name) if name else None,
                "changed": outcome in ("switched", "already-switched")}

    if provider not in PROVIDERS:
        return result("unsupported")
    if not STATE.is_dir():
        return result("unmanaged")
    with open(STATE / ".lock", "a") as lock:
        fcntl.flock(lock, fcntl.LOCK_EX)
        revisions = {}
        for name in accounts(provider):
            try:
                revisions[identity(provider, name)] = name
            except OSError:
                continue
        if failed_identity not in revisions:
            return result("unmanaged")
        try:
            status = json.loads((STATE / "status.json").read_text())
        except (OSError, ValueError):
            status = {}
        status.setdefault("providers", {
            p: {"active": active(p), "accounts": {n: {"tier": -1} for n in accounts(p)}}
            for p in PROVIDERS})
        blocked = {k: expiry for k, expiry in status.get("exhausted", {}).items() if expiry > now()}
        status["exhausted"] = blocked
        key = failed_identity + ":" + model
        blocked[key] = now() + 300
        current = active(provider)
        current_id = identity(provider, current) if current else None
        selected = status.setdefault("selections", {})
        selection_key = provider + ":" + model
        evidence = selected.get(selection_key, {})
        # A delayed failure must preserve a healthy current account even when
        # the monitor/manual selection did not record model-specific evidence.
        if (current_id is not None and current_id != failed_identity
                and blocked.get(current_id + ":" + model, 0) <= now()):
            usable = evidence.get("identity") == current_id and evidence.get("until", 0) > now()
            known = True
            if not usable:
                try:
                    usable, known, _ = model_availability(provider, current, model)
                except (OSError, ValueError, KeyError, urllib.error.URLError):
                    known = False
            if usable or not known:
                if usable:
                    selected[selection_key] = {"identity": current_id, "until": now() + 300}
                write_private(STATE / "status.json", json.dumps(status) + "\n")
                return result("already-switched" if usable else "unknown", current)
        candidates = []
        unknown = False
        for revision, name in revisions.items():
            if (blocked.get(revision + ":" + model, 0) > now()
                    or (revision == current_id and current_id != failed_identity)):
                continue
            try:
                usable, known, utilization = model_availability(provider, name, model)
                if usable:
                    candidates.append((utilization, name))
                elif not known:
                    unknown = True
            except (OSError, ValueError, KeyError, urllib.error.URLError):
                unknown = True
        if candidates:
            chosen = min(candidates)[1]
            set_active(provider, chosen)
            selected[selection_key] = {"identity": identity(provider, chosen), "until": now() + 300}
            outcome = result("already-switched" if chosen == current else "switched", chosen)
        else:
            outcome = result("unknown" if unknown else "exhausted", current)
        write_private(STATE / "status.json", json.dumps(status) + "\n")
        return outcome


def cmd_run(providers: str, argv: list[str], retry_exit: set[int] | None = None,
            base: dict[str, str] | None = None, model: str | None = None,
            retry_safe: bool = False) -> int:
    """Preserve stdout streaming; replay only one identified managed provider/model."""
    for attempt in (1, 2):
        env = with_accounts(providers, dict(os.environ) if base is None else base)
        proc = subprocess.Popen(argv, env=env, stderr=subprocess.PIPE)
        seen: list[bytes] = []

        def pump() -> None:
            for chunk in iter(lambda: proc.stderr.read1(4096), b""):
                sys.stderr.buffer.write(chunk)
                sys.stderr.buffer.flush()
                seen.append(chunk)

        t = threading.Thread(target=pump, daemon=True)
        t.start()
        code = proc.wait()
        t.join()
        text = b"".join(seen).decode("utf-8", "replace")
        retryable = code != 0 and (retry_exit is None or code in retry_exit)
        if (not retryable or attempt == 2 or not model or providers not in PROVIDERS
                or not USAGE_LIMIT_RE.search(text) or managed_name(providers, env) is None):
            return code
        before = env[marker(providers)]
        outcome = exhausted(providers, before, model)
        after = with_accounts(providers, env)
        if not retry_safe or not outcome["changed"] or after.get(marker(providers)) == before:
            return code
        print("ai-accounts: managed account changed; retrying once", file=sys.stderr)
    return code


def is_shim_dir(directory: str) -> bool:
    me = Path(__file__).resolve()
    return any((Path(directory or ".") / name).resolve() == me for name in SHIMS)


def cmd_shim(name: str, args: list[str]) -> int:
    """Run the real ``name`` found on PATH after the shim directory, on the active account(s)."""
    dirs = os.environ.get("PATH", "").split(os.pathsep)
    shim_dirs = [d for d in dirs if is_shim_dir(d)]
    rest = [d for d in dirs if d not in shim_dirs]
    real = next((str(c) for d in rest if (c := Path(d or ".") / name).is_file()
                 and os.access(c, os.X_OK)), None)
    if real is None:
        sys.exit(f"ai-accounts: no real {name} on PATH")
    if name == "loopzero":
        # loopzero resolves claude/codex on PATH and runs them in its sandbox: hide the shims.
        reviewer = Path.home() / ".local/lib/codex-reviewer"
        pinned = reviewer / "codex"
        if reviewer.is_dir() and pinned.is_file() and os.access(pinned, os.X_OK):
            rest.insert(0, str(reviewer))
        base = {**os.environ, "PATH": os.pathsep.join(rest)}
        os.execve(real, [real, *args], with_accounts(SHIMS[name], base))
        return 127
    # Put the shims first for the session's own shells, so their commands switch accounts too.
    base = {**os.environ, "PATH": os.pathsep.join([str(Path(sys.argv[0]).absolute().parent), *rest])}
    os.execve(real, [real, *args], with_accounts(SHIMS[name], base))
    return 127


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "status"
    if cmd == "launch":
        parser = argparse.ArgumentParser(prog="ai-accounts launch")
        parser.add_argument("provider")
        parser.add_argument("--model", required=True)
        args = parser.parse_args(argv[1:])
        print(json.dumps(launch(args.provider, args.model, dict(os.environ))))
        return 0
    if cmd == "exec" and len(argv) >= 5 and argv[2] == "--identity" and argv[4] == "--":
        return cmd_pinned_exec(argv[1], argv[3], argv[5:])
    if cmd == "exhausted":
        parser = argparse.ArgumentParser(prog="ai-accounts exhausted")
        parser.add_argument("provider")
        parser.add_argument("--identity", required=True)
        parser.add_argument("--model", required=True)
        args = parser.parse_args(argv[1:])
        print(json.dumps(exhausted(args.provider, args.identity, args.model)))
        return 0
    if cmd == "status":
        f = STATE / "status.json"
        status = json.loads(f.read_text()) if f.is_file() else check(quiet=True)
        status["stale"] = now() - status.get("checked_at", 0) > 600
        for provider, info in status.get("providers", {}).items():
            info["active"] = active(provider)
            for name, result in info["accounts"].items():
                snapshot_fields(result, name, status.get("checked_at", 0))
                if provider == "claude":
                    result["weekly_used_percent"] = claude_weekly_used_percent(result)
        if "--json" in argv:
            print(json.dumps(status, indent=1))
        else:
            print_status(status)
        return 0
    if cmd == "check":
        quiet = "--quiet" in argv
        status = check(quiet=quiet)
        failed = any(info["accounts"] and all(result["tier"] == -1
                                               for result in info["accounts"].values())
                     for info in status["providers"].values())
        return int(quiet and failed)
    if cmd == "use" and len(argv) == 3 and argv[1] in PROVIDERS:
        if argv[2] not in accounts(argv[1]):
            sys.exit(f"ai-accounts: unknown {argv[1]} account {argv[2]!r}")
        STATE.mkdir(parents=True, exist_ok=True, mode=0o700)
        with open(STATE / ".lock", "a") as lock:
            fcntl.flock(lock, fcntl.LOCK_EX)
            set_active(argv[1], argv[2])
        log(f"{argv[1]}: manual -> {argv[2]}")
        print(f"{argv[1]} active: {argv[2]}")
        return 0
    if cmd == "label" and len(argv) == 4 and argv[1] == "claude":
        if argv[2] not in accounts("claude"):
            sys.exit(f"ai-accounts: unknown claude account {argv[2]!r}")
        write_private(STATE / "claude/emails" / argv[2], argv[3] + "\n")
        print(f"claude {argv[2]}: {argv[3]}; run `ai-accounts check` to refresh status")
        return 0
    if cmd == "add" and len(argv) == 3 and argv[1] in PROVIDERS:
        return cmd_add(argv[1], argv[2])
    retry_safe = False
    if cmd == "run" and "--retry-safe" in argv[2:]:
        index = argv.index("--retry-safe", 2)
        if "--" not in argv[:index]:
            retry_safe = True
            argv = argv[:index] + argv[index + 1:]
    model = None
    if cmd == "run" and "--model" in argv[2:]:
        index = argv.index("--model", 2)
        if "--" not in argv[:index] and index + 1 < len(argv):
            model = argv[index + 1]
            argv = argv[:index] + argv[index + 2:]
    retry_exit = None
    if cmd == "run" and len(argv) >= 4 and argv[2] == "--retry-exit":
        retry_exit = {int(n) for n in argv[3].split(",")}
        argv = argv[:2] + argv[4:]
    if cmd in ("exec", "run") and len(argv) >= 3 and argv[2] == "--":
        if any(p not in PROVIDERS for p in argv[1].split(",")):
            print(json.dumps({"outcome": "unsupported", "changed": False}))
            return 2
        if cmd == "exec":
            return cmd_exec(argv[1], argv[3:])
        return cmd_run(argv[1], argv[3:], retry_exit, model=model, retry_safe=retry_safe)
    print(__doc__.strip(), file=sys.stderr)
    return 2


if __name__ == "__main__":
    shim = Path(sys.argv[0]).name
    sys.exit(cmd_shim(shim, sys.argv[1:]) if shim in SHIMS else main(sys.argv[1:]))
